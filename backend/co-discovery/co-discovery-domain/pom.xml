<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.campusoverflow</groupId>
        <artifactId>co-discovery</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>co-discovery-domain</artifactId>
    <packaging>jar</packaging>
    <name>Discovery 内容发现 :: domain（纯 Java）</name>
    <dependencies>
        <dependency>
            <groupId>com.campusoverflow</groupId>
            <artifactId>co-shared-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- 版本、prepare-agent / report 的执行配置全部从父 POM 的 <pluginManagement> 继承。
                 check-coverage 这里显式写一个 execution，是因为父 POM 若直接给 check 配 execution，
                 会顺着继承链跑到所有模块上（co-shared-kernel 行覆盖只有 0.31，verify 必红）。
                 这里只负责「激活」，阈值与 haltOnFailure 仍只在父 POM 维护一份。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-coverage</id>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
