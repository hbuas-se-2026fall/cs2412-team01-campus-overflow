# 统一编辑器的编码、缩进与行尾，避免 diff 里出现纯格式噪音。
# 说明见 CONTRIBUTING.md；IntelliJ 需要勾选 Settings → Editor → Code Style → Enable EditorConfig support。
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,ts,tsx,js,jsx,css,html,xml,http}]
indent_size = 2

[*.md]
# Markdown 行尾两个空格是换行语义，不要被编辑器删掉
trim_trailing_whitespace = false

[*.{sh,py}]
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab